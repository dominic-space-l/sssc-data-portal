# Map backend settings. Copy to .env (git-ignored) and fill in:
#   cp .env.example .env
# The backend loads .env at startup (backend.config.Config.from_env). Variables set
# in the real environment win over this file. All three may be left blank: the app
# still starts and /api/health still works, but the map's data routes won't.

# Supabase API URL. This is the local stack (`npm run db:start` from the repo root).
SUPABASE_URL=http://127.0.0.1:54321

# The anon (publishable) key ONLY. For the local stack, copy PUBLISHABLE_KEY or ANON_KEY
# from `npx supabase status -o env`. The backend refuses a service-role or secret key.
SUPABASE_KEY=

# Seconds browsers and proxies may cache layer responses. Default 300.
CACHE_MAX_AGE=300
