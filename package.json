{
  "name": "enviro-monitoring-database",
  "private": true,
  "workspaces": [
    "map/frontend",
    "portal/frontend"
  ],
  "scripts": {
    "start:map": "npm start -w map-frontend",
    "start:portal": "npm start -w portal-frontend",
    "backend:map": "uv --directory map/backend run backend",
    "dev:map": "concurrently -k -n api,web -c blue,green \"npm run backend:map\" \"npm run start:map\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present -- --watch=false"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
