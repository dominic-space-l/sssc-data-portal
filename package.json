{
  "name": "enviro-monitoring-database",
  "private": true,
  "workspaces": [
    "map/frontend",
    "portal/frontend"
  ],
  "scripts": {
    "start:map": "npm start -w map-frontend",
    "start:portal": "npm start -w portal-frontend",
    "backend:map": "uv --directory map/backend run backend",
    "dev:map": "concurrently -k -n api,web -c blue,green \"npm run backend:map\" \"npm run start:map\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present -- --watch=false",
    "lint": "eslint map/frontend/src portal/frontend/src",
    "format": "prettier --write \"{map,portal}/frontend/src/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"{map,portal}/frontend/src/**/*.{ts,html,scss}\"",
    "lint:backend": "uv --directory map/backend run ruff check && uv --directory map/backend run ruff format --check",
    "test:backend": "uv --directory map/backend run pytest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --schema public,map_private --level warning --fail-on error && supabase db advisors --type security --fail-on error"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.6.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "supabase": "^3.1.0",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
